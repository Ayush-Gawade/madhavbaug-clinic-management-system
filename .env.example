# =============================================================================
# Madhavbaug Clinic Management System — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="Madhavbaug Clinic Management System"
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins for the SPA.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000
# Hostname Caddy serves (production: the real public hostname, without scheme).
PUBLIC_HOST=localhost

# --- Security / auth -------------------------------------------------------
# Generate strong values: `openssl rand -hex 32`
SECRET_KEY=change-me-development-only-secret-key-0000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160   # 14 days
JWT_ALGORITHM=HS256
# Password hashing is Argon2id (via pwdlib); no secret needed here.

# --- Database --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=madhavbaug
POSTGRES_PASSWORD=change-me
POSTGRES_DB=madhavbaug
# Optional full override; if set, wins over the POSTGRES_* pieces above.
# DATABASE_URL=postgresql+asyncpg://madhavbaug:change-me@localhost:5432/madhavbaug
# Test database used by the integration test suite.
TEST_DATABASE_URL=postgresql+asyncpg://madhavbaug:change-me@localhost:5432/madhavbaug_test

# --- Redis / Celery --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Media storage (protected local disk volume) ---------------------------
# Inbound WhatsApp media bytes are downloaded here by a Celery worker and served
# only through short-lived HMAC-signed URLs (below).
MEDIA_ROOT=./data/media
# Signs media URLs; must be a unique, random value in production.
MEDIA_SIGNING_SECRET=change-me-media-signing-secret-000000000000
# How long a signed media link stays valid, in seconds.
MEDIA_URL_TTL_SECONDS=300

# --- OpenAI (text + vision) ------------------------------------------------
OPENAI_API_KEY=
# Any OpenAI-compatible gateway works here (OpenRouter, Together, local vLLM).
# Leave empty to use api.openai.com. When set, provider-prefixed model ids are
# required, e.g. OPENAI_TEXT_MODEL=openai/gpt-4o-mini with
# OPENAI_BASE_URL=https://openrouter.ai/api/v1.
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# Master switch: disable all outbound AI calls (keeps deterministic core safe).
AI_ENABLED=true
# inline = analyze inbound messages inside the webhook request (dev/test);
# deferred = enqueue a Celery task (required in production so webhooks never
# block on a slow provider; needs a running worker).
AI_PROCESSING_MODE=inline

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Feature flag: when false, messaging workflows stay disabled (safe default).
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
# Required when WHATSAPP_ENABLED=true in production; the API refuses to boot
# without both values so a live deployment cannot silently dry-run.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
# Required in production: the webhook route is always mounted, so a live
# deployment must always be able to verify signatures (fail-closed).
WHATSAPP_APP_SECRET=
# Reject unsigned inbound webhooks. True by default; production always
# enforces signatures regardless of this value.
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true
# Non-production-only escape hatch for local dry-runs and tests. When true,
# unsigned payloads are accepted outside production and recorded with
# signature_verified=false. The production validator refuses this.
WEBHOOK_ALLOW_UNSIGNED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Dedicated timeout for outbound Graph API calls (seconds).
WHATSAPP_TIMEOUT_SECONDS=30
# Meta only allows free-form (text) messages within this many hours of the
# patient's last inbound message. Business-initiated messages outside the window
# must use an approved template.
WHATSAPP_SESSION_WINDOW_HOURS=24
# Enforce the session window: outside it, dispatch sends an approved template
# instead of free-form text (which Meta rejects with error 131047). Required in
# production when WHATSAPP_ENABLED=true.
WHATSAPP_ENFORCE_SESSION_WINDOW=false

# --- Bootstrap admin (created by the seed command if absent) ---------------
BOOTSTRAP_ADMIN_EMAIL=admin@madhavbaug.in
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME="Clinic Owner"
